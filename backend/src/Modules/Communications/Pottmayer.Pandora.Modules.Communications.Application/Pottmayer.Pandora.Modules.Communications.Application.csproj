<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pottmayer.Pandora.Modules.Communications.Tests" />
    <!-- Tars: Feature flags and authorization -->
    <PackageReference Include="Pottmayer.Tars.FeatureFlags" Version="0.1.0" />
    <PackageReference Include="Pottmayer.Tars.Security.Authorization" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Communications.Abstractions/Pottmayer.Pandora.Modules.Communications.Abstractions.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Communications.Contracts/Pottmayer.Pandora.Modules.Communications.Contracts.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Communications.Domain/Pottmayer.Pandora.Modules.Communications.Domain.csproj" />
    <ProjectReference Include="../../Notes/Pottmayer.Pandora.Modules.Notes.Abstractions/Pottmayer.Pandora.Modules.Notes.Abstractions.csproj" />
    <!-- Integrations: credentials (usage source) and the account events -->
    <ProjectReference Include="../../Integrations/Pottmayer.Pandora.Modules.Integrations.Abstractions/Pottmayer.Pandora.Modules.Integrations.Abstractions.csproj" />
    <ProjectReference Include="../../Integrations/Pottmayer.Pandora.Modules.Integrations.Contracts/Pottmayer.Pandora.Modules.Integrations.Contracts.csproj" />
    <!-- Channels: NotifyUserRequested -->
    <ProjectReference Include="../../Channels/Pottmayer.Pandora.Modules.Channels.Contracts/Pottmayer.Pandora.Modules.Channels.Contracts.csproj" />
    <!-- Tars: Messaging -->
    <PackageReference Include="Pottmayer.Tars.Messaging" Version="0.1.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <!-- Opened messages: the raw RFC 822 bytes are parsed here (same version MailKit pulls) -->
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <!-- Tars: Core -->
    <PackageReference Include="Pottmayer.Tars.Core.Cqrs" Version="0.1.0" />
    <PackageReference Include="Pottmayer.Tars.Core.Mediator" Version="0.1.0" />
    <!-- Tars: Data -->
    <PackageReference Include="Pottmayer.Tars.Data.Abstractions" Version="0.1.0" />
  </ItemGroup>

</Project>
