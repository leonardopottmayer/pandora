<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates ship inside the assembly: they are content reviewed with the code that fills them.
         WithCulture=false stops MSBuild from reading the ".en" / ".pt-BR" segment as a culture and
         exiling those files into satellite assemblies; LogicalName then keeps the name verbatim,
         hyphens and all. -->
    <EmbeddedResource Include="Templates/Files/*.txt"
                      WithCulture="false"
                      LogicalName="Pottmayer.Pandora.Modules.Channels.Infrastructure.Templates.Files.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Channels.Abstractions/Pottmayer.Pandora.Modules.Channels.Abstractions.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Channels.Application/Pottmayer.Pandora.Modules.Channels.Application.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Channels.Domain/Pottmayer.Pandora.Modules.Channels.Domain.csproj" />
    <!-- Tars: Data -->
    <PackageReference Include="Pottmayer.Tars.Data.Abstractions" Version="0.0.5" />
    <!-- Tars: Communication e-mail providers (logging + MailKit) -->
    <PackageReference Include="Pottmayer.Tars.Communication.Email" Version="0.0.5" />
    <PackageReference Include="Pottmayer.Tars.Communication.Email.MailKit" Version="0.0.5" />
    <!-- Tars: Communication Telegram provider (Bot API over HttpClient) -->
    <PackageReference Include="Pottmayer.Tars.Communication.Telegram.Abstractions" Version="0.0.5" />
    <PackageReference Include="Pottmayer.Tars.Communication.Telegram" Version="0.0.5" />
    <!-- Hosting / options / logging for the dispatcher worker and provider config -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
