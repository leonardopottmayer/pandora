<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Assistant.Abstractions/Pottmayer.Pandora.Modules.Assistant.Abstractions.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Assistant.Contracts/Pottmayer.Pandora.Modules.Assistant.Contracts.csproj" />
    <ProjectReference Include="../Pottmayer.Pandora.Modules.Assistant.Domain/Pottmayer.Pandora.Modules.Assistant.Domain.csproj" />
    <!-- Cross-module port: the Gemini API key lives in Integrations and is fetched per call. -->
    <ProjectReference Include="../../Integrations/Pottmayer.Pandora.Modules.Integrations.Abstractions/Pottmayer.Pandora.Modules.Integrations.Abstractions.csproj" />
    <!-- Cross-module port: the reference clock (time zone / week start) for resolving relative dates. -->
    <ProjectReference Include="../../Identity/Pottmayer.Pandora.Modules.Identity.Abstractions/Pottmayer.Pandora.Modules.Identity.Abstractions.csproj" />
    <!-- Cross-module contracts: inbound message the Assistant interprets + the reply it asks Channels to send. -->
    <ProjectReference Include="../../Channels/Pottmayer.Pandora.Modules.Channels.Contracts/Pottmayer.Pandora.Modules.Channels.Contracts.csproj" />
    <!-- Cross-module port: downloads the bytes of an inbound voice note by its opaque media ref. -->
    <ProjectReference Include="../../Channels/Pottmayer.Pandora.Modules.Channels.Abstractions/Pottmayer.Pandora.Modules.Channels.Abstractions.csproj" />
    <!-- Tars: Messaging (integration-event subscribe + publish) -->
    <PackageReference Include="Pottmayer.Tars.Messaging" Version="0.0.16" />
    <!-- Tars: AI transport -->
    <PackageReference Include="Pottmayer.Tars.Ai.Abstractions" Version="0.0.16" />
    <PackageReference Include="Pottmayer.Tars.Ai.Chat.Abstractions" Version="0.0.16" />
    <!-- Tars: Core -->
    <PackageReference Include="Pottmayer.Tars.Core.Cqrs" Version="0.0.16" />
    <PackageReference Include="Pottmayer.Tars.Core.Mediator" Version="0.0.16" />
    <!-- Tars: Data -->
    <PackageReference Include="Pottmayer.Tars.Data.Abstractions" Version="0.0.16" />
  </ItemGroup>

</Project>
