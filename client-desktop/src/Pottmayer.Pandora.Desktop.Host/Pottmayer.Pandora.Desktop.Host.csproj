<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\pandora.ico</ApplicationIcon>
    <AssemblyName>PandoraDesktop</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pottmayer.Pandora.Desktop.Abstractions\Pottmayer.Pandora.Desktop.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local pages (first run / offline), served through a WebView2 virtual host. -->
    <Content Include="shell\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\pandora.ico" LogicalName="pandora.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pottmayer.Pandora.Desktop.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
