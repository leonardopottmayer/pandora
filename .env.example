# Template for a per-environment env file. Copy to .env.<environment>
# (e.g. .env.prod, .env.staging), fill with real values, and keep a copy in
# Bitwarden. docker compose loads it via --env-file. See docs/deployment.md.

# --- Environment identity ---
# Isolates containers/network/volumes between environments. Use a distinct
# value per environment: pandora-prod, pandora-staging, ...
COMPOSE_PROJECT_NAME=pandora-prod
# ASP.NET Core environment name (Production for every real deploy).
ASPNETCORE_ENVIRONMENT=Production
# Compose profiles to activate. Set to "mailhog" to run the email catcher
# (staging). Leave empty in prod (uses a real SMTP provider instead).
COMPOSE_PROFILES=

# --- Database (shared per-tier DB, set up from the homelab repo) ---
# Bring up the tier's Postgres first (homelab repo). TIER_NETWORK/DB_HOST select
# which tier DB to use; POSTGRES_* are Pandora's OWN database + role (not superuser).
TIER_NETWORK=staging
DB_HOST=staging-postgres
POSTGRES_USER=pandora
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pandora

# --- Backend secrets (generate strong random values) ---
# At least 32 chars.
JWT_SIGNING_KEY=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARS
# Base64 of 32 random bytes.
MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Base64 of 32 random bytes. Encrypts the credentials users connect (Google tokens, API keys,
# mailbox passwords). Required: the stack refuses to start without it. Never change it once set,
# or every connected account must be reconnected.
DATA_PROTECTION_KEY=CHANGE_ME_BASE64_32_BYTES
# E-mail of the master administrator: promoted to the admin role at startup and when activated.
ADMIN_EMAIL=

# true: a new account can only sign in after an administrator approves it (ADMIN_EMAIL is exempt).
REQUIRE_ACCOUNT_APPROVAL=false

# Proxies in front of the backend that append to X-Forwarded-For: 1 for the bundled nginx alone,
# 2 with another proxy in front (Cloudflare Tunnel, Traefik). Rate limiting counts by this IP.
REVERSE_PROXY_FORWARD_LIMIT=1

# --- Published images (GHCR) ---
# Same images serve every environment; only this file differs.
# prod -> pin a release version (:1.0.0); staging -> :dev (built on every push to dev).
BACKEND_IMAGE=ghcr.io/leonardopottmayer/pandora-backend:1.0.0
FRONTEND_IMAGE=ghcr.io/leonardopottmayer/pandora-frontend:1.0.0

# --- Email ---
# Staging: point at the bundled Mailhog (needs COMPOSE_PROFILES=mailhog above).
# Prod: set to a real SMTP provider's host/port instead.
SMTP_HOST=mailhog
SMTP_PORT=1025
# Prod (Brevo): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USE_STARTTLS=true, the login and
# SMTP key from Brevo (SMTP & API -> SMTP), and a sender address verified in Brevo (Senders).
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@pandora.local
# Mailhog web UI port on the host (only used when the mailhog profile is on).
MAILHOG_UI_PORT=8732

# --- Telegram (Channels and Assistant) ---
# Tokens from @BotFather. Secret. Create a separate pair of bots per environment:
# Telegram hands a token's updates to one reader, so staging and prod cannot share one.
# Leave everything empty to keep Telegram disabled.
# The notifications bot: sends notifications and links accounts.
TELEGRAM_BOT_TOKEN=
# The notifications bot's @username (without @). Only this bot needs one: the "Link Telegram" button
# builds t.me/<username>?start=<code> with it. The assistant bot is opened by the user directly.
TELEGRAM_BOT_USERNAME=
# The assistant bot: reads and answers the user's messages.
TELEGRAM_ASSISTANT_BOT_TOKEN=

# --- Google (Integrations: Calendar, Tasks, Gmail) ---
# OAuth client from Google Cloud Console (docs/deployment/google-and-gemini-setup.md).
# Its redirect URIs must include ${APP_BASE_URL}/api/v1/integrations/google/callback.
# Leave GOOGLE_CLIENT_ID empty to keep Google disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Host port exposed for the frontend (nginx) ---
# The ONLY host port this stack uses (postgres/backend stay internal to the
# Docker network). Reserve one per environment: prod=8730, staging=8731, ...
HTTP_PORT=8730

# --- Public base URL (used in emailed activation / password-reset links) ---
# Defaults to http://localhost:${HTTP_PORT}. Uncomment and set to reach it from
# another device (homelab LAN IP + port) or, in phase 2, a public https URL.
# No trailing slash.
# APP_BASE_URL=http://192.168.1.50:8731
